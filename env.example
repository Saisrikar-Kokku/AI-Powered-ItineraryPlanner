# Supabase Configuration (PUBLIC - exposed to browser)
# Copy this file to .env.local and replace with your actual Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# OpenRouter API Key (PRIVATE - server-side only, NOT exposed to browser)
# Get your API key at: https://openrouter.ai
# Free models available including meta-llama/llama-3.1-8b-instruct:free
# IMPORTANT: Do NOT prefix this with NEXT_PUBLIC_ - it should remain server-side only
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: App URL for production
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app